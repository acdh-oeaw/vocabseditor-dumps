<http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K082> a skos:Concept ;
    dc:contributor "Ingo Börner",
        "Isabella Schwentner" ;
    dc:source """Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            295."""@de ;
    dcterms:created "2026-09-19T20:11:53.340820+00:00"^^xsd:dateTime ;
    dcterms:modified "2026-09-19T20:11:53.505221+00:00"^^xsd:dateTime ;
    skos:inScheme <http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/> ;
    skos:note """Umformulierung, die nicht von grammatikalischen (morphologischen,
            syntaktischen oder orthographischen) Regeln abhängt."""@de ;
    skos:prefLabel "Freie Variante"@de ;
    skos:topConceptOf <http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/> .

<http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K085> a skos:Concept ;
    dc:contributor "Ingo Börner",
        "Isabella Schwentner" ;
    dc:source """Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            295."""@de ;
    dcterms:created "2026-09-19T20:12:21.765838+00:00"^^xsd:dateTime ;
    dcterms:modified "2026-09-19T20:12:21.973608+00:00"^^xsd:dateTime ;
    skos:inScheme <http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/> ;
    skos:note """Umformulierung, die an grammatikalische Gesetzmäßigkeiten der
            Sprache gebunden ist (Korrektur) oder das Ergebnis einer freien Variante auf den Rest
            des Satzes überträgt (In freier Variante wird das Subjekt des Satzes "Das Haus ist
            klein" erweitert zu "Das Haus und der Garten"; daraus folgt zwangsläufig eine gebundene
            Variante, nämlich die Korrektur von "ist" zu "sind")."""@de ;
    skos:prefLabel "Gebundene Variante"@de ;
    skos:topConceptOf <http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/> .

<http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K088> a skos:Concept ;
    dc:contributor "Ingo Börner",
        "Isabella Schwentner" ;
    dc:source """Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            295."""@de ;
    dcterms:created "2026-09-19T20:12:26.228478+00:00"^^xsd:dateTime ;
    dcterms:modified "2026-09-19T20:12:26.447460+00:00"^^xsd:dateTime ;
    skos:inScheme <http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/> ;
    skos:note """Ausgabe, die in gedruckter Form und in der chronologischen
            Reihenfolge des Schreibprozesses alle überlieferten textgenetischen Dokumente eines
            Werkes oder eines Werkfragments vorstellt; Beispiel: die genetische Ausgabe von Un cæur
            simple von Flaubert, Hrsg. G. Bonaccorso (siehe Bibliogrphie)."""@de ;
    skos:prefLabel "Genetische Ausgabe"@de ;
    skos:topConceptOf <http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/> .

<http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K090> a skos:Concept ;
    dc:contributor "Ingo Börner",
        "Isabella Schwentner" ;
    dc:source """Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            295."""@de ;
    dcterms:created "2026-09-19T20:12:00.233390+00:00"^^xsd:dateTime ;
    dcterms:modified "2026-09-19T20:12:00.486247+00:00"^^xsd:dateTime ;
    skos:inScheme <http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/> ;
    skos:note """Basiseinheit des Schreibens; die Gesamtheit aller graphischen
            Signifikaten umfaßt einerseits die Buchstaben des Alphabets, andererseits
            Interpunktionszeichen und metaschriftliche Zeichen (Einfügungszeichen, Verweiszeichen,
            Durchstreichungsstriche, Farbstriche usw.)."""@de ;
    skos:prefLabel "Graphischer Signifikant"@de ;
    skos:topConceptOf <http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/> .

<http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K091> a skos:Concept ;
    dc:contributor "Ingo Börner",
