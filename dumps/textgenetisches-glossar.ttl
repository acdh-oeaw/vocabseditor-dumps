    skos:prefLabel "Schreiberhand"@de ;
    skos:topConceptOf <http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/> .

<http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K199> a skos:Concept ;
    dc:contributor "Ingo Börner",
