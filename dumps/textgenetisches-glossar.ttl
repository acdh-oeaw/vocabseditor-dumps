<http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K052> a skos:Concept ;
    dc:contributor "Ingo Börner",
        "Isabella Schwentner" ;
    dc:source """Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            294."""@de ;
    dcterms:created "2026-09-19T20:11:43.817022+00:00"^^xsd:dateTime ;
    dcterms:modified "2026-09-19T20:11:43.952630+00:00"^^xsd:dateTime ;
    skos:inScheme <http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/> ;
    skos:note """persönliche Note von Schriftzügen; am Duktus erkennt man eine
            Handschrift als von einem bestimmten Autor stammend; je nach physischer und psychischer
            Verfassung des Schreibers kann der Duktus gewissen Veränderungen
            unterliegen."""@de ;
    skos:prefLabel "Duktus"@de ;
    skos:topConceptOf <http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/> .

