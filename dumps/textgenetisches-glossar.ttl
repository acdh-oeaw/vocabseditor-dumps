<http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K025> a skos:Concept ;
    dc:contributor "Ingo Börner",
        "Isabella Schwentner" ;
    dc:source """Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            293."""@de ;
    dcterms:created "2026-09-19T20:12:16.296255+00:00"^^xsd:dateTime ;
    dcterms:modified "2026-09-19T20:12:16.654325+00:00"^^xsd:dateTime ;
    skos:inScheme <http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/> ;
    skos:note """im Laufe des 2. Jahrhunderts v. Chr. erfundener Schriftträger in
            Form einer Rolle aus Papyrus oder Pergament; nach einer langen Übergangsphase
            schließlich ganz vom Kodex abgelöst."""@de ;
    skos:prefLabel "Buchrolle"@de ;
    skos:topConceptOf <http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/> .

