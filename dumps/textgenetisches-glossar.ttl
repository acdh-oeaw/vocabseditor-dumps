<http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K015> a skos:Concept ;
    dc:contributor "Ingo Börner",
        "Isabella Schwentner" ;
    dcterms:created "2026-09-19T20:12:17.085989+00:00"^^xsd:dateTime ;
    dcterms:modified "2026-09-19T20:12:17.268116+00:00"^^xsd:dateTime ;
    skos:inScheme <http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/> ;
    skos:note """Papiereinheit im "Rohzustand", d.h. in der Größe, wie das Papier
            aus der Presse kommt. Erst durch ein- oder mehrmaliges Falten entsteht das Blattformat;
            ohne Faltung: Planoformat; einmalige Faltung: Folio; zweimalige Faltung: Quart;
            dreimalige Faltung: Oktav."""@de ;
    skos:prefLabel "Bogen"@de ;
    skos:topConceptOf <http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/> .

