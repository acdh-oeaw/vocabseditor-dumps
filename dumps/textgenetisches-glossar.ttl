    dcterms:modified "2026-09-19T20:11:58.186044+00:00"^^xsd:dateTime ;
    skos:editorialNote "enthalten in der Erläuterung zu \"Diplomatische Transkription\" u. \"Linearisierte Transkription\""@de ;
    skos:inScheme <http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/> ;
    skos:prefLabel "Topographie"@de ;
    skos:scopeNote "Topographie des beschriebenen Raumes, Topographie der Seite"@de ;
    skos:topConceptOf <http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/> .

