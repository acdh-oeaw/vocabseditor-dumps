<http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K194> a skos:Concept ;
    dc:contributor "Ingo Börner",
        "Isabella Schwentner" ;
    dc:source """Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            297."""@de ;
    dcterms:created "2026-09-19T20:12:17.681412+00:00"^^xsd:dateTime ;
    dcterms:modified "2026-09-19T20:12:17.791290+00:00"^^xsd:dateTime ;
    skos:editorialNote "aus der note zu Textgenetische Phase"@de ;
    skos:inScheme <http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/> ;
    skos:note """handschriftliches Stadium eines Textes, das grundsätzlich keine
            Streichungen mehr enthält und grundsätzlich die letzte Phase der Textgenese darstellt;
            vom Autor selbst oder einem Sekretär angefertigt."""@de ;
    skos:prefLabel "Reinschrift"@de ;
    skos:topConceptOf <http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/> .

<http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K196> a skos:Concept ;
    dc:contributor "Ingo Börner",
        "Isabella Schwentner" ;
    dc:source """Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            297."""@de ;
    dcterms:created "2026-09-19T20:11:46.732586+00:00"^^xsd:dateTime ;
    dcterms:modified "2026-09-19T20:11:46.809658+00:00"^^xsd:dateTime ;
    skos:editorialNote "aus der note zu Duktus"@de ;
    skos:inScheme <http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/> ;
    skos:note """derjenige, dessen Hand den Text auf einem Schriftträger fixiert; im
            weiteren Sinne auch derjenige, der auf der Schreibmaschine oder am Computer Texte
            niederschreibt; Schreiber ist nicht systematisch synonym mit Autor (siehe
            Schreiberhand)."""@de ;
    skos:prefLabel "Schreiber"@de ;
    skos:topConceptOf <http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/> .

<http://vocabs.acdh.oeaw.ac.at/tgg/v1.0/K198> a skos:Concept ;
    dc:contributor "Ingo Börner",
        "Isabella Schwentner" ;
    dc:source """Almuth Grésillon: Literarische Handschriften. Einführung in die
            'critique génétique'. Aus dem Französischen übersetzt von Frauke Rother und Wolfgang
            Günther, redaktionell überarbeitet von Almuth Grésillon. Bern u.a.: Peter Lang 1999, S.
            297."""@de ;
